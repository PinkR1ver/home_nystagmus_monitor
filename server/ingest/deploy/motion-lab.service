[Unit]
Description=Motion Lab collection ingestion
After=network.target postgresql.service
Requires=postgresql.service
[Service]
User=motionlab
Group=motionlab
WorkingDirectory=/opt/motion-lab
Environment=DATABASE_URL=dbname=motion_lab user=motionlab host=/var/run/postgresql
Environment=DATA_DIR=/var/lib/motion-lab
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 127.0.0.1 --port 8789 --workers 2 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/motion-lab
[Install]
WantedBy=multi-user.target
